	column Год-Месяц
		lineageTag: 4f21f20b-0ac2-48d1-bf61-5e36ba2163bf
		summarizeBy: none
		isNameInferred
		sourceColumn: [Год-Месяц]

		annotation SummarizationSetBy = Automatic

	partition Календарь = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(MIN(bikeshare_trips[Дата начала]), MAX(bikeshare_trips[Дата начала])),
				    "Год", YEAR([Date]),
				    "Квартал", "Q" & QUARTER([Date]),
				    "Номер месяца", MONTH([Date]),
				    "Месяц", FORMAT([Date], "MMM"),
				    "Номер дня недели", WEEKDAY([Date], 2),
				    "День недели", FORMAT([Date], "ddd"),
				    "Год-Месяц", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = dd90c2f25eaf4fec8c7d25406beaa89f

