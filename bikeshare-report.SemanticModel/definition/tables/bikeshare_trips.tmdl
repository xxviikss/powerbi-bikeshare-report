table bikeshare_trips
	lineageTag: aa595035-d614-4d1c-a007-ba1eaf130202

	measure 'Количество поездок' = COUNTROWS(bikeshare_trips)
		formatString: 0
		lineageTag: 38a5c94a-045d-429c-8e67-907d6a59de90

	measure 'Поездки прошлый месяц' = CALCULATE([Количество поездок], DATEADD('Календарь'[Date], -1, MONTH))
		lineageTag: 1d3f579e-eb3d-4ccf-b6b8-6007e771a46d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Рост к пред. месяцу %' = DIVIDE([Количество поездок] - [Поездки прошлый месяц], [Поездки прошлый месяц])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 77c8ce11-ea1e-4ee7-8ab4-c982376f4ea0

	measure 'Поездки прошлый квартал' = CALCULATE([Количество поездок], DATEADD('Календарь'[Date], -1, QUARTER))
		formatString: 0
		lineageTag: 5d2f6e2d-b607-46b8-839f-7da7236decee

	measure 'Рост к пред. кварталу %' = DIVIDE([Количество поездок] - [Поездки прошлый квартал], [Поездки прошлый квартал])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 62ffdf9c-8f9d-4235-9f10-48f5e025be9a

	measure 'Поездки прошлый год' = CALCULATE([Количество поездок], DATEADD('Календарь'[Date], -1, YEAR))
		formatString: 0
		lineageTag: da2efe8e-02f5-47ba-80f6-772fb78dc777

	measure 'Рост к пред. году %' = DIVIDE([Количество поездок] - [Поездки прошлый год], [Поездки прошлый год])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c1b6ef1f-087b-4d6a-a9a6-d0072decc305

	measure 'Среднее поездок в день' = DIVIDE([Количество поездок], DISTINCTCOUNT(bikeshare_trips[Дата начала]))
		formatString: 0
		lineageTag: e0157dc7-1c31-4b1c-80b3-5e392717293d

	measure 'Средняя продолжительность, мин' = DIVIDE(AVERAGE(bikeshare_trips[duration_sec]), 60)
		formatString: 0.0
		lineageTag: 9a99cd85-7871-4a9c-be85-4c2160ef45f4

	measure 'Поездки на место в день' = DIVIDE([Количество поездок], SUM(bikeshare_station_info[capacity]) * DISTINCTCOUNT(bikeshare_trips[Дата начала]))
		formatString: 0.00
		lineageTag: 5071cf21-411d-4dc3-b912-07f9450c4aca

