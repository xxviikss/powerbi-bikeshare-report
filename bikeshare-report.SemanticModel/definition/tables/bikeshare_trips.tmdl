	column 'Дата начала' = DATE(YEAR(bikeshare_trips[start_date]), MONTH(bikeshare_trips[start_date]), DAY(bikeshare_trips[start_date]))
		formatString: General Date
		lineageTag: abcae3b0-634c-4493-aed7-799891ca493f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Час = HOUR(bikeshare_trips[start_date])
		formatString: 0
		lineageTag: 418d768b-8c9c-4797-8616-8fd73e5cae4c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Маршрут = bikeshare_trips[start_station_name] & " → " & bikeshare_trips[end_station_name]
		lineageTag: 913714c3-25e8-4e2d-8eed-684d652ef587
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Возраст = YEAR(bikeshare_trips[start_date]) - bikeshare_trips[member_birth_year]
		formatString: 0
		lineageTag: 3d1d9958-f371-432b-adc4-ff50434262f8
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Возрастная группа' = SWITCH(TRUE(), ISBLANK(bikeshare_trips[member_birth_year]), "Не указан", [Возраст] < 18, "до 18", [Возраст] <= 25, "18-25", [Возраст] <= 35, "26-35", [Возраст] <= 45, "36-45", [Возраст] <= 60, "46-60", [Возраст] <= 90, "61-90", "Аномалия")
		lineageTag: b4fe4d8d-1b3d-4d44-8e7f-af8a6b856bd4
		summarizeBy: none
		sortByColumn: 'Порядок группы'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = User

	column 'Порядок группы' = SWITCH(TRUE(), ISBLANK(bikeshare_trips[member_birth_year]), 7, [Возраст] < 18, 1, [Возраст] <= 25, 2, [Возраст] <= 35, 3, [Возраст] <= 45, 4, [Возраст] <= 60, 5, [Возраст] <= 90, 6, 8)
		formatString: 0
		lineageTag: 92bfecf8-f90c-4289-afdb-9a6fcbdd45f5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition bikeshare_trips = m
		mode: import
		source =
